$ErrorActionPreference = "Stop"

Write-Host "==============================" -ForegroundColor Cyan
Write-Host " FIVE M ANIMAL FARM BOT" -ForegroundColor Cyan
Write-Host "==============================" -ForegroundColor Cyan

# ตรวจสอบ Python
if (-not (Get-Command py -ErrorAction SilentlyContinue)) {
    Write-Host "Python not found. Please install Python first."
    Read-Host "Press Enter to exit"
    exit
}

# สร้างพื้นที่ทำงานชั่วคราว
$work = Join-Path $env:TEMP "AnimalFarmBot"
New-Item -ItemType Directory -Force -Path $work | Out-Null

$base = "https://raw.githubusercontent.com/Ming2488/5M-AnimalFarmBot2/main"

# โหลดทุกไฟล์ที่บอทต้องใช้ (ทับของเก่าทุกครั้ง)
$files = @(
    "animal_farm.py",
    "requirements.txt",
    "animal_buy_button.png",
    "animal_feed_button.png",
    "animal_collect_button.png",
    "animal_garage_header.png",
    "animal_car_card.png",
    "animal_open_trunk_button.png",
    "animal_beef_item.png",
    "animal_max_button.png",
    "animal_confirm_button.png"
)

foreach ($f in $files) {
    Write-Host "Downloading $f ..."
    Invoke-WebRequest -UseBasicParsing "$base/$f" -OutFile (Join-Path $work $f)
}

py -m pip install pyautogui opencv-python pillow keyboard
