$ErrorActionPreference = "Stop"

Write-Host "==============================" -ForegroundColor Cyan
Write-Host " FIVE M ANIMAL FARM BOT" -ForegroundColor Cyan
Write-Host "==============================" -ForegroundColor Cyan

# ตรวจสอบ Python
if (-not (Get-Command py -ErrorAction SilentlyContinue)) {
    Write-Host "Python not found. Please install Python first."
    Read-Host "Press Enter to exit"
    exit
}

# สร้างพื้นที่ทำงานชั่วคราว
$work = Join-Path $env:TEMP "AnimalFarmBot"
New-Item -ItemType Directory -Force -Path $work | Out-Null

# URL ของโค้ด (แก้ USERNAME ให้เป็นชื่อ GitHub ของคุณ)
$base = "https://raw.githubusercontent.com/USERNAME/FiveM-AnimalFarmBot/main"

# ดาวน์โหลดโค้ด
Invoke-WebRequest "$base/animal_farm.py" -OutFile "$work/animal_farm.py"

# ติดตั้งไลบรารี
py -m pip install pyautogui keyboard

# เปิดบอท
py "$work/animal_farm.py"
